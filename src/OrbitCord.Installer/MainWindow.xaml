<Window x:Class="OrbitCord.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrbitCord Setup"
        Width="640" Height="610"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}"
        Icon="Assets/orbitcord.ico">
    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="#121319"
                  MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="OrbitCord Setup"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="13" />

                <Button Grid.Column="1"
                        Click="MinimizeButton_OnClick"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        FontSize="18"
                        Content="—" />

                <Button Grid.Column="2"
                        Click="CloseButton_OnClick"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        FontSize="16"
                        Content="✕" />
            </Grid>

            <Grid Grid.Row="1" Margin="46,28,46,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                    <Image Source="Assets/orbitcord-logo.png"
                           Width="112"
                           Height="112"
                           HorizontalAlignment="Center"
                           Stretch="Uniform" />
                    <TextBlock Text="OrbitCord"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               FontSize="31"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Discord, lighter."
                               Margin="0,5,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="14" />
                    <TextBlock x:Name="VersionText"
                               Margin="0,7,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11.5" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,26,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="InstallButton"
                            Grid.Column="0"
                            Height="50"
                            Content="Install"
                            Style="{StaticResource PrimaryButtonStyle}"
                            FontWeight="SemiBold"
                            Click="InstallButton_OnClick" />

                    <Button x:Name="UpdateButton"
                            Grid.Column="2"
                            Height="50"
                            Content="Update"
                            FontWeight="SemiBold"
                            Click="UpdateButton_OnClick" />

                    <Button x:Name="UninstallButton"
                            Grid.Column="4"
                            Height="50"
                            Content="Uninstall"
                            FontWeight="SemiBold"
                            Background="#2B1B1D"
                            BorderBrush="#5E2A2D"
                            Foreground="#FFB8BA"
                            Click="UninstallButton_OnClick" />
                </Grid>

                <Border x:Name="InstallOptionsPanel"
                        Grid.Row="2"
                        Margin="0,22,0,0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Install location"
                                   Margin="2,0,0,8"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11.5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InstallPathBox"
                                     Grid.Column="0"
                                     VerticalContentAlignment="Center" />
                            <Button x:Name="BrowseButton"
                                    Grid.Column="2"
                                    Content="Browse"
                                    Click="BrowseButton_OnClick" />
                        </Grid>

                        <Grid Margin="2,12,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="DesktopShortcutCheckBox"
                                      Grid.Column="0"
                                      Content="Desktop shortcut"
                                      IsChecked="False" />
                            <CheckBox x:Name="LaunchAfterInstallCheckBox"
                                      Grid.Column="1"
                                      Content="Launch when finished"
                                      IsChecked="False" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText"
                           Grid.Row="3"
                           Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           Text="Ready."
                           TextWrapping="Wrap" />

                <Grid Grid.Row="4" />

                <ProgressBar x:Name="InstallProgress"
                             Grid.Row="5"
                             Height="7"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Background="#111218"
                             Foreground="{StaticResource PrimaryBrush}" />
            </Grid>
        </Grid>
    </Border>
</Window>
