<Window x:Class="OrbitCord.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="300"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        Opacity="1">
    <Grid Background="Transparent">
        <StackPanel x:Name="BrandPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <ScaleTransform x:Name="BrandScale" ScaleX="0.92" ScaleY="0.92" />
            </StackPanel.RenderTransform>
            <StackPanel.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.48" Color="#000000" />
            </StackPanel.Effect>

            <Image x:Name="SplashIcon"
                   Width="128" Height="128"
                   HorizontalAlignment="Center"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True" />

            <TextBlock x:Name="BrandNameText" Text="OrbitCord"
                       Margin="0,22,0,0"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="34"
                       FontWeight="Bold"
                       TextOptions.TextFormattingMode="Display"
                       TextOptions.TextRenderingMode="ClearType">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFDFBFF" Offset="0" />
                        <GradientStop Color="#FFE8D7FF" Offset="0.45" />
                        <GradientStop Color="#FFC9B6FF" Offset="1" />
                    </LinearGradientBrush>
                </TextBlock.Foreground>
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.35" Color="#B56BFF" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Visibility="Collapsed"
                   Text="Booting OrbitCord…" />
    </Grid>
</Window>
