<Window x:Class="OrbitCord.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrbitCord Setup"
        Width="820" Height="590"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}"
        Icon="Assets/orbitcord.ico">
    <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#121319" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="Assets/orbitcord-logo.png" Width="26" Height="26" Stretch="Uniform" />
                    <TextBlock Text="OrbitCord Setup" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
                </StackPanel>
                <Button Grid.Column="1" Click="MinimizeButton_OnClick" Padding="0" BorderThickness="0" Background="Transparent" FontSize="18" Content="—" />
                <Button Grid.Column="2" Click="CloseButton_OnClick" Padding="0" BorderThickness="0" Background="Transparent" FontSize="16" Content="✕" />
            </Grid>

            <Grid Grid.Row="1" Margin="38,28,38,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Image Source="Assets/orbitcord-logo.png" Width="74" Height="74" HorizontalAlignment="Left" Stretch="Uniform" />
                    <TextBlock x:Name="HeadingText" Text="Install OrbitCord" Margin="0,18,0,0" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubheadingText" Text="A lightweight Discord Web client for Windows." Margin="0,8,0,0"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="14" TextWrapping="Wrap" />

                    <Border Margin="0,26,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel x:Name="InstallOptionsPanel">
                            <TextBlock Text="Installation folder" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Choose where the OrbitCord app should live." Margin="0,4,0,10" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InstallPathBox" Grid.Column="0" VerticalContentAlignment="Center" />
                                <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse…" Click="BrowseButton_OnClick" />
                            </Grid>

                            <Separator Margin="0,18,0,14" Background="{StaticResource BorderBrush}" />
                            <CheckBox x:Name="DesktopShortcutCheckBox" Content="Create a Desktop shortcut" IsChecked="False" />
                            <CheckBox x:Name="LaunchAfterInstallCheckBox" Content="Launch OrbitCord when setup finishes" IsChecked="False" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SafetyText" Margin="2,14,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap"
                               Text="Setup verifies the official GitHub Release SHA-256 before replacing any program files. Your OrbitCord profile and settings stay outside the install folder." />
                </StackPanel>

                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Setup summary" FontSize="16" FontWeight="SemiBold" />
                            <Border x:Name="MaintenanceBadge" Margin="0,12,0,0" Padding="10,6" Background="#20233A" CornerRadius="7" Visibility="Collapsed">
                                <TextBlock x:Name="MaintenanceBadgeText" Text="Existing installation detected" Foreground="#C9CEFF" FontSize="12" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,22,0,0">
                            <TextBlock Text="Version" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            <TextBlock x:Name="VersionText" Margin="0,3,0,0" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Install mode" Margin="0,16,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            <TextBlock x:Name="ModeText" Margin="0,3,0,0" FontSize="14" FontWeight="SemiBold" Text="Fresh install" />
                            <TextBlock Text="User data" Margin="0,16,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            <TextBlock Text="Preserved in %LocalAppData%\OrbitCord" Margin="0,3,0,0" FontSize="12.5" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,20,0,0">
                            <TextBlock x:Name="StatusText" Text="Ready to install." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ProgressBar x:Name="InstallProgress" Height="7" Minimum="0" Maximum="100" Value="0" Background="#111218" Foreground="{StaticResource PrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,22,0,0">
                            <Button x:Name="PrimaryActionButton" Content="Install OrbitCord" Style="{StaticResource PrimaryButtonStyle}" Click="PrimaryActionButton_OnClick" />
                            <Button x:Name="UninstallButton" Content="Uninstall OrbitCord" Margin="0,10,0,0" Background="#2B1B1D" BorderBrush="#5E2A2D"
                                    Foreground="#FFB8BA" Visibility="Collapsed" Click="UninstallButton_OnClick" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
