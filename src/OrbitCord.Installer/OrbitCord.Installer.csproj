<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OrbitCord-Setup</AssemblyName>
    <RootNamespace>OrbitCord.Installer</RootNamespace>
    <ApplicationIcon>..\OrbitCord.App\Assets\orbitcord.ico</ApplicationIcon>
    <Product>OrbitCord Setup</Product>
    <Description>Branded per-user installer for OrbitCord</Description>
    <Authors>OrbitCord contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="OrbitCordVersion" Value="$(OrbitCordVersion)" />
    <AssemblyMetadata Include="OrbitCordRepositoryUrl" Value="$(RepositoryUrl)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\OrbitCord.App\Assets\orbitcord-logo.png" Link="Assets\orbitcord-logo.png" />
    <Resource Include="..\OrbitCord.App\Assets\orbitcord.ico" Link="Assets\orbitcord.ico" />
  </ItemGroup>
</Project>
