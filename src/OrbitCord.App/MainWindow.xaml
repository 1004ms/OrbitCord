<Window x:Class="OrbitCord.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="OrbitCord" Width="1280" Height="820"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#090A0F"
        Icon="Assets/orbitcord.ico">
    <Grid>
        <wv2:WebView2 x:Name="DiscordView" />
        <Border x:Name="Toast"
                Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,18,18,0" Padding="14,10"
                CornerRadius="10" Background="#E6111219" BorderBrush="#337C00FF" BorderThickness="1">
            <TextBlock x:Name="ToastText" Foreground="#FFF7F4FF" FontSize="12" FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
